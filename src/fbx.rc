#include <windows.h>
#include <commctrl.h>
#include "resource.h"
1 24 "fbx.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 3,0,0,0
PRODUCTVERSION 3,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "FBX Pin & Roll-up"
      VALUE "ProductName", "FBX Pin & Roll-up"
      VALUE "FileVersion", "3.0.0.0"
      VALUE "ProductVersion", "3.0.0-preview"
      VALUE "LegalCopyright", "GPL-3.0-or-later. Based on FileBox eXtender (C) Hyperionics Technology LLC."
      VALUE "OriginalFilename", "fbx.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

IDD_SETTINGS DIALOGEX 0, 0, 334, 266
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "FBX Pin & Roll-up - Settings"
FONT 9, "Segoe UI"
BEGIN
  GROUPBOX "All programs", -1, 7, 4, 320, 90
  AUTOCHECKBOX "&Push-pin button to keep windows on top", IDC_PINBTN, 15, 16, 300, 10
  AUTOCHECKBOX "&Roll-up button to display only the title bar of a window", IDC_ROLLBTN, 15, 28, 300, 10
  AUTOCHECKBOX "When rolled up, &keep the window bar on top", IDC_ROLLTOP, 27, 40, 288, 10
  LTEXT "Move the buttons left by", -1, 15, 57, 82, 8
  EDITTEXT IDC_MOVELEFT, 99, 55, 28, 12, ES_AUTOHSCROLL
  LTEXT "pixels, and by", -1, 131, 57, 46, 8
  EDITTEXT IDC_MOVELEFTMAX, 179, 55, 28, 12, ES_AUTOHSCROLL
  LTEXT "more if a window is maximized", -1, 211, 57, 110, 8
  AUTOCHECKBOX "&Start with Windows", IDC_AUTOSTART, 15, 76, 300, 10
  GROUPBOX "Individual programs", -1, 7, 98, 320, 142
  LISTBOX IDC_APPS, 15, 110, 104, 104, LBS_NOTIFY | LBS_SORT | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
  PUSHBUTTON "Pick an &app...", IDC_PICK, 15, 219, 58, 14
  PUSHBUTTON "Re&move", IDC_REMOVE, 77, 219, 42, 14
  AUTOCHECKBOX "&Do not handle this program at all", IDC_IGNORE, 127, 110, 192, 10
  AUTOCHECKBOX "No push-pi&n button", IDC_NOPIN, 127, 122, 192, 10
  AUTOCHECKBOX "No roll-&up button", IDC_NOROLL, 127, 134, 192, 10
  LTEXT "Button position:", IDC_POSLABEL, 127, 150, 192, 8
  AUTORADIOBUTTON "Right, next to the window's own buttons", IDC_RIGHT, 135, 161, 184, 10, WS_GROUP | WS_TABSTOP
  AUTORADIOBUTTON "Left end of the title bar", IDC_LEFT, 135, 173, 184, 10
  LTEXT "Shift left by", IDC_OFFLABEL, 127, 191, 42, 8, WS_GROUP
  EDITTEXT IDC_OFFSET, 171, 189, 40, 12, ES_AUTOHSCROLL
  CONTROL "", IDC_OFFSPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 10, 12
  LTEXT "pixels (negative = right)", IDC_OFFLABEL2, 215, 191, 108, 8
  LTEXT "Rolled-up height", IDC_RHLABEL, 127, 208, 56, 8
  EDITTEXT IDC_ROLLHEIGHT, 185, 206, 28, 12, ES_AUTOHSCROLL | ES_NUMBER
  LTEXT "pixels (0 = automatic)", IDC_RHLABEL2, 217, 208, 104, 8
  LTEXT "Pick a program to give it its own settings.", IDC_HINT, 127, 223, 194, 8
  LTEXT "Changes show immediately. Cancel undoes them.", -1, 9, 250, 200, 8
  DEFPUSHBUTTON "OK", IDOK, 219, 246, 50, 14
  PUSHBUTTON "Cancel", IDCANCEL, 277, 246, 50, 14
END
