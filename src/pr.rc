#include <windows.h>
#include <commctrl.h>
#include "resource.h"
1 24 "pr.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Alex Potemkin, ShotPorter"
      VALUE "FileDescription", "Pin&Roll"
      VALUE "ProductName", "Pin&Roll"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "ProductVersion", "1.0.0"
      VALUE "LegalCopyright", "GPL-3.0-or-later. Based on FileBox eXtender (C) Hyperionics Technology LLC."
      VALUE "OriginalFilename", "pr.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

IDR_HELP_HTML RCDATA "help.html"
IDR_HELP_PNG RCDATA "help-settings.png"

IDD_SETTINGS DIALOGEX 0, 0, 560, 248
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Pin&Roll - Settings"
FONT 9, "Segoe UI"
BEGIN
  GROUPBOX "All programs", -1, 7, 4, 232, 216
  AUTOCHECKBOX "&Push-pin button to keep windows on top", IDC_PINBTN, 15, 16, 216, 10
  AUTOCHECKBOX "&Roll-up button to display only the title bar", IDC_ROLLBTN, 15, 28, 216, 10
  AUTOCHECKBOX "When rolled up, &keep the window bar on top", IDC_ROLLTOP, 27, 40, 204, 10
  AUTOCHECKBOX "Peek: show a rolled-up window while the mouse rests on its roll-up button", IDC_PEEK, 27, 52, 204, 18, BS_MULTILINE | BS_TOP
  LTEXT "Move the buttons left by", -1, 15, 78, 84, 8
  EDITTEXT IDC_MOVELEFT, 101, 76, 28, 12, ES_AUTOHSCROLL
  LTEXT "pixels", -1, 133, 78, 96, 8
  LTEXT "...and by", -1, 15, 94, 84, 8
  EDITTEXT IDC_MOVELEFTMAX, 101, 92, 28, 12, ES_AUTOHSCROLL
  LTEXT "more if a window is maximized", -1, 133, 94, 100, 8
  LTEXT "Button size", -1, 15, 110, 84, 8
  EDITTEXT IDC_BTNSIZE, 101, 108, 28, 12, ES_AUTOHSCROLL | ES_NUMBER
  LTEXT "% of normal", -1, 133, 110, 96, 8
  LTEXT "Hot keys for the active window:", -1, 15, 127, 216, 8
  LTEXT "Pin", -1, 27, 141, 30, 8
  CONTROL "", IDC_PINKEY, HOTKEY_CLASS, WS_BORDER | WS_TABSTOP, 61, 139, 90, 12
  LTEXT "Roll-up", -1, 27, 157, 30, 8
  CONTROL "", IDC_ROLLKEY, HOTKEY_CLASS, WS_BORDER | WS_TABSTOP, 61, 155, 90, 12
  AUTOCHECKBOX "&Start with Windows", IDC_AUTOSTART, 15, 174, 216, 10
  AUTOCHECKBOX "Run as administrator (buttons also on &Task Manager and other elevated programs)", IDC_ADMIN, 15, 186, 216, 18, BS_MULTILINE | BS_TOP
  AUTOCHECKBOX "Check for a new &version once a week (contacts github.com)", IDC_UPDATE, 15, 206, 216, 10
  GROUPBOX "Individual programs (right-click a button to add one)", -1, 245, 4, 308, 216
  LISTBOX IDC_APPS, 253, 16, 100, 178, LBS_NOTIFY | LBS_SORT | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
  PUSHBUTTON "Pick an &app...", IDC_PICK, 253, 199, 56, 14
  PUSHBUTTON "Re&move", IDC_REMOVE, 313, 199, 40, 14
  AUTOCHECKBOX "&Do not handle this program at all", IDC_IGNORE, 361, 16, 184, 10
  AUTOCHECKBOX "No push-pi&n button", IDC_NOPIN, 361, 28, 184, 10
  AUTOCHECKBOX "No roll-&up button", IDC_NOROLL, 361, 40, 184, 10
  AUTO3STATE "Peek when rolled up (filled = as set on the left)", IDC_APPPEEK, 361, 52, 184, 10
  LTEXT "Button position:", IDC_POSLABEL, 361, 70, 184, 8
  AUTORADIOBUTTON "Right, next to the window's own buttons", IDC_RIGHT, 369, 81, 176, 10, WS_GROUP | WS_TABSTOP
  AUTORADIOBUTTON "Left end of the title bar", IDC_LEFT, 369, 93, 176, 10
  LTEXT "Shift left by", IDC_OFFLABEL, 361, 112, 56, 8, WS_GROUP
  EDITTEXT IDC_OFFSET, 419, 110, 40, 12, ES_AUTOHSCROLL
  CONTROL "", IDC_OFFSPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 10, 12
  LTEXT "pixels (negative = right)", IDC_OFFLABEL2, 463, 112, 86, 8
  LTEXT "Shift down by", IDC_DOWNLABEL, 361, 128, 56, 8
  EDITTEXT IDC_DOWN, 419, 126, 40, 12, ES_AUTOHSCROLL
  CONTROL "", IDC_DOWNSPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 10, 12
  LTEXT "pixels (negative = up)", IDC_DOWNLABEL2, 463, 128, 86, 8
  LTEXT "Button size", IDC_APPSIZELABEL, 361, 144, 56, 8
  EDITTEXT IDC_APPSIZE, 419, 142, 28, 12, ES_AUTOHSCROLL | ES_NUMBER
  LTEXT "% (0 = as set on the left)", IDC_APPSIZELABEL2, 451, 144, 98, 8
  LTEXT "Rolled-up height", IDC_RHLABEL, 361, 160, 56, 8
  EDITTEXT IDC_ROLLHEIGHT, 419, 158, 28, 12, ES_AUTOHSCROLL | ES_NUMBER
  LTEXT "pixels (0 = automatic)", IDC_RHLABEL2, 451, 160, 98, 8
  PUSHBUTTON "&Help", IDC_HELPBTN, 7, 228, 44, 14
  PUSHBUTTON "Open .&ini file", IDC_OPENINI, 55, 228, 60, 14
  LTEXT "Changes show immediately. Cancel undoes them.", -1, 125, 231, 300, 8
  DEFPUSHBUTTON "OK", IDOK, 445, 228, 50, 14
  PUSHBUTTON "Cancel", IDCANCEL, 503, 228, 50, 14
END

IDD_ABOUT DIALOGEX 0, 0, 250, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Pin&Roll"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "", IDC_ABOUTTITLE, 10, 10, 230, 10, SS_NOPREFIX
  LTEXT "Push-pin (always on top) and roll-up title bar buttons for Windows 10 and 11.", -1, 10, 24, 230, 18
  CONTROL "", IDC_ABOUTLINKS, "SysLink", WS_TABSTOP, 10, 46, 230, 44
  LTEXT "Started as a rewrite of these two functions of FileBox eXtender, (C) 1999-2011 Greg Kochaniak, Hyperionics Technology LLC.", -1, 10, 94, 230, 18
  LTEXT "Free software under the GNU General Public License v3 or later.", -1, 10, 114, 230, 10
  DEFPUSHBUTTON "OK", IDOK, 190, 130, 50, 14
END
