#include <windows.h>
#include <commctrl.h>
#include "resource.h"
1 24 "pr.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Alex Potemkin, ShotPorter"
      VALUE "FileDescription", "Pin&Roll"
      VALUE "ProductName", "Pin&Roll"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "ProductVersion", "1.0.0"
      VALUE "LegalCopyright", "GPL-3.0-or-later. Based on FileBox eXtender (C) Hyperionics Technology LLC."
      VALUE "OriginalFilename", "pr.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

IDR_HELP_HTML RCDATA "help.html"
IDR_HELP_PNG RCDATA "help-settings.png"

IDD_SETTINGS DIALOGEX 0, 0, 340, 380
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Pin&Roll - Settings"
FONT 9, "Segoe UI"
BEGIN
  GROUPBOX "All programs", -1, 7, 4, 326, 162
  AUTOCHECKBOX "&Push-pin button to keep windows on top", IDC_PINBTN, 15, 16, 300, 10
  AUTOCHECKBOX "&Roll-up button to display only the title bar of a window", IDC_ROLLBTN, 15, 28, 300, 10
  AUTOCHECKBOX "When rolled up, &keep the window bar on top", IDC_ROLLTOP, 27, 40, 288, 10
  AUTOCHECKBOX "Peek: show a rolled-up window while the mouse rests on its roll-up button", IDC_PEEK, 27, 52, 288, 10
  LTEXT "Move the buttons left by", -1, 15, 69, 82, 8
  EDITTEXT IDC_MOVELEFT, 99, 67, 28, 12, ES_AUTOHSCROLL
  LTEXT "pixels, and by", -1, 131, 69, 46, 8
  EDITTEXT IDC_MOVELEFTMAX, 179, 67, 28, 12, ES_AUTOHSCROLL
  LTEXT "more if a window is maximized", -1, 211, 69, 116, 8
  LTEXT "Button size", -1, 15, 85, 40, 8
  EDITTEXT IDC_BTNSIZE, 57, 83, 28, 12, ES_AUTOHSCROLL | ES_NUMBER
  LTEXT "% of normal", -1, 89, 85, 60, 8
  LTEXT "Hot keys for the active window:   pin", -1, 15, 102, 120, 8
  CONTROL "", IDC_PINKEY, HOTKEY_CLASS, WS_BORDER | WS_TABSTOP, 137, 100, 70, 12
  LTEXT "roll-up", -1, 215, 102, 26, 8
  CONTROL "", IDC_ROLLKEY, HOTKEY_CLASS, WS_BORDER | WS_TABSTOP, 243, 100, 70, 12
  AUTOCHECKBOX "&Start with Windows", IDC_AUTOSTART, 15, 120, 300, 10
  AUTOCHECKBOX "Run as administrator (buttons also on &Task Manager and other elevated programs)", IDC_ADMIN, 15, 134, 312, 10
  AUTOCHECKBOX "Check for a new &version once a week (contacts github.com)", IDC_UPDATE, 15, 148, 312, 10
  GROUPBOX "Individual programs (right-click a button to add one)", -1, 7, 170, 326, 170
  LISTBOX IDC_APPS, 15, 182, 104, 132, LBS_NOTIFY | LBS_SORT | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
  PUSHBUTTON "Pick an &app...", IDC_PICK, 15, 319, 58, 14
  PUSHBUTTON "Re&move", IDC_REMOVE, 77, 319, 42, 14
  AUTOCHECKBOX "&Do not handle this program at all", IDC_IGNORE, 127, 182, 198, 10
  AUTOCHECKBOX "No push-pi&n button", IDC_NOPIN, 127, 194, 198, 10
  AUTOCHECKBOX "No roll-&up button", IDC_NOROLL, 127, 206, 198, 10
  AUTO3STATE "Peek when rolled up (filled = as set above)", IDC_APPPEEK, 127, 218, 198, 10
  LTEXT "Button position:", IDC_POSLABEL, 127, 233, 198, 8
  AUTORADIOBUTTON "Right, next to the window's own buttons", IDC_RIGHT, 135, 244, 190, 10, WS_GROUP | WS_TABSTOP
  AUTORADIOBUTTON "Left end of the title bar", IDC_LEFT, 135, 256, 190, 10
  LTEXT "Shift left by", IDC_OFFLABEL, 127, 273, 44, 8, WS_GROUP
  EDITTEXT IDC_OFFSET, 173, 271, 40, 12, ES_AUTOHSCROLL
  CONTROL "", IDC_OFFSPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 10, 12
  LTEXT "pixels (negative = right)", IDC_OFFLABEL2, 217, 273, 110, 8
  LTEXT "Shift down by", IDC_DOWNLABEL, 127, 289, 44, 8
  EDITTEXT IDC_DOWN, 173, 287, 40, 12, ES_AUTOHSCROLL
  CONTROL "", IDC_DOWNSPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 10, 12
  LTEXT "pixels (negative = up)", IDC_DOWNLABEL2, 217, 289, 110, 8
  LTEXT "Button size", IDC_APPSIZELABEL, 127, 305, 44, 8
  EDITTEXT IDC_APPSIZE, 173, 303, 28, 12, ES_AUTOHSCROLL | ES_NUMBER
  LTEXT "% (0 = as set above)", IDC_APPSIZELABEL2, 205, 305, 122, 8
  LTEXT "Rolled-up height", IDC_RHLABEL, 127, 321, 56, 8
  EDITTEXT IDC_ROLLHEIGHT, 185, 319, 28, 12, ES_AUTOHSCROLL | ES_NUMBER
  LTEXT "pixels (0 = automatic)", IDC_RHLABEL2, 217, 321, 110, 8
  LTEXT "Changes show immediately. Cancel undoes them.", -1, 9, 346, 300, 8
  PUSHBUTTON "&Help", IDC_HELPBTN, 7, 360, 44, 14
  PUSHBUTTON "Open .&ini file", IDC_OPENINI, 55, 360, 60, 14
  DEFPUSHBUTTON "OK", IDOK, 225, 360, 50, 14
  PUSHBUTTON "Cancel", IDCANCEL, 283, 360, 50, 14
END

IDD_ABOUT DIALOGEX 0, 0, 250, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Pin&Roll"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "", IDC_ABOUTTITLE, 10, 10, 230, 10, SS_NOPREFIX
  LTEXT "Push-pin (always on top) and roll-up title bar buttons for Windows 10 and 11.", -1, 10, 24, 230, 18
  CONTROL "", IDC_ABOUTLINKS, "SysLink", WS_TABSTOP, 10, 46, 230, 44
  LTEXT "Started as a rewrite of these two functions of FileBox eXtender, (C) 1999-2011 Greg Kochaniak, Hyperionics Technology LLC.", -1, 10, 94, 230, 18
  LTEXT "Free software under the GNU General Public License v3 or later.", -1, 10, 114, 230, 10
  DEFPUSHBUTTON "OK", IDOK, 190, 130, 50, 14
END
